# Environment configuration template
# Copy this file to .env and replace the values with your local settings.

# MySQL Database Connection (SQLAlchemy format)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://<username>:<password>@127.0.0.1:3306/resume_ats

# JWT Secret Key (Required; use at least 32 random characters in every environment)
# Generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="replace_with_a_random_32_byte_hex_secret"

# JWT Algorithm
ALGORITHM=HS256

# Token expiration time in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend origin(s) allowed by CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Server-side Gemini API Key (Never expose in frontend code)
GEMINI_API_KEY=your_gemini_api_key_here

# Environment mode (development / production)
ENVIRONMENT=development
